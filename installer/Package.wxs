<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="puzzler-gui"
           Manufacturer="HFunction2013"
           Version="$(var.Version)"
           UpgradeCode="01b9f2c3-20a4-478f-8462-f1e0ed6007f0"
           Language="1033"
           Scope="perMachine"
           Compressed="true">

    <MajorUpgrade DowngradeErrorMessage="A newer version of puzzler-gui is already installed." />
    <Media Id="1" EmbedCab="yes" Cabinet="app.cab" />

    <ui:WixUI Id="WixUI_Mondo" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="LICENSE.rtf" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch puzzler-gui" />
    <Property Id="WixShellExecTarget" Value="[INSTALLFOLDER]PuzzlerGui.exe" />
    <CustomActionRef Id="Wix4ShellExec_X64" />

    <UI>
      <Publish Dialog="ExitDialog"
                Control="Finish"
                Event="DoAction"
                Value="Wix4ShellExec_X64"
                Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <Icon Id="AppIcon" SourceFile="puzzler-gui.ico" />

    <Feature Id="Main" Title="puzzler-gui" Description="The GUI application and puzzler solver." Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="FileAssociation" />
      <ComponentRef Id="RemoveUserSettings" />
    </Feature>

    <Feature Id="StartMenuShortcut" Title="Start Menu shortcut" Description="Create a shortcut in the Start Menu." Level="1">
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Feature Id="DesktopShortcut" Title="Desktop shortcut" Description="Create a shortcut on the desktop." Level="1">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="puzzler-gui" />
    </StandardDirectory>

    <StandardDirectory Id="AppDataFolder">
      <Directory Id="PuzzlerSettingsDir" Name="puzzler-gui">
        <Component Id="RemoveUserSettings"
                   Guid="2b360c9d-ffa1-4902-a3c2-c08c28d7147f">
          <RegistryValue Root="HKCU"
                         Key="Software\HFunction2013\puzzler-gui"
                         Name="Installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
          <RemoveFile Id="RemoveSettingsJson" On="uninstall" Name="settings.json" />
          <RemoveFile Id="RemoveRecoveryPuzzle" On="uninstall" Name="recovery.pzle" />
          <RemoveFile Id="RemoveOtherSettingsFiles" On="uninstall" Name="*" />
          <RemoveFolder Id="RemoveSettingsDir" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="FileAssociation" Guid="4bc4e6bd-0eed-4ffc-b3a9-730f24a8f6f8">
        <RegistryValue Root="HKCU"
                       Key="Software\HFunction2013\puzzler-gui"
                       Name="FileAssociation"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <RegistryKey Root="HKCR" Key=".pzle">
          <RegistryValue Value="PuzzlerGui.PuzzleFile" Type="string" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="PuzzlerGui.PuzzleFile">
          <RegistryValue Name="FriendlyTypeName" Value="puzzler puzzle file" Type="string" />
          <RegistryValue Name="DefaultIcon" Value="[INSTALLFOLDER]puzzler-gui.ico,0" Type="string" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue Value="&quot;[INSTALLFOLDER]PuzzlerGui.exe&quot; &quot;%1&quot;" Type="string" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="puzzler-gui" />
      <Component Id="StartMenuShortcut" Guid="d5a8b62f-dea0-4014-bbcc-bd7e5a7e5229">
        <RegistryValue Root="HKCU"
                       Key="Software\HFunction2013\puzzler-gui"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <Shortcut Id="StartMenuShortcut"
                  Directory="ProgramMenuDir"
                  Name="puzzler-gui"
                  Target="[INSTALLFOLDER]PuzzlerGui.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="099e0356-f959-415e-ab7c-8b089ba66430">
        <RegistryValue Root="HKCU"
                       Key="Software\HFunction2013\puzzler-gui"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="puzzler-gui"
                  Target="[INSTALLFOLDER]PuzzlerGui.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
      </Component>
    </StandardDirectory>

  </Package>

</Wix>
