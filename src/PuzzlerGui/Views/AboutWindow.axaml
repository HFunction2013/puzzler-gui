<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PuzzlerGui.Views"
        x:Class="PuzzlerGui.Views.AboutWindow"
        x:DataType="views:AboutWindow"
        Title="{Binding Loc[dialog.aboutTitle]}"
        Width="520"
        Height="340"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}">

  <StackPanel Margin="28" Spacing="12" VerticalAlignment="Top">
    <StackPanel Orientation="Horizontal" Spacing="14">
      <Image Source="avares://PuzzlerGui/Assets/puzzler-gui-256.png" Width="72" Height="72" />
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="title" Text="puzzler-gui" />
        <TextBlock x:Name="VersionText" Classes="hint" Text="" />
      </StackPanel>
    </StackPanel>

    <TextBlock TextWrapping="Wrap"
               Text="{Binding Loc[dialog.aboutDescription]}" />

    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="{Binding Loc[dialog.aboutBuiltWith]}" />

    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="https://github.com/HFunction2013/puzzler-gui" />

    <Button Content="{Binding Loc[dialog.close]}" HorizontalAlignment="Right" MinWidth="88"
            HorizontalContentAlignment="Center" Click="OnCloseClick" />
  </StackPanel>
</Window>
